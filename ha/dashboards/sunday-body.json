{
  "title": "Sunday Body",
  "views": [
    {
      "title": "Body",
      "path": "body",
      "icon": "mdi:robot-happy-outline",
      "cards": [
        {
          "type": "custom:mushroom-template-card",
          "entity": "select.sunday_body_face_state",
          "primary": "Sunday Body",
          "secondary": "{% if is_state('select.sunday_body_face_state','unavailable') %}Offline{% else %}{{ states('select.sunday_body_face_state')|capitalize }} \u00b7 {{ states('select.sunday_body_expression') }} face \u00b7 {{ states('select.sunday_body_display') }} display{% endif %}",
          "icon": "mdi:robot-happy-outline",
          "icon_color": "{{ 'red' if is_state('select.sunday_body_face_state','unavailable') else 'green' }}",
          "tap_action": {
            "action": "more-info"
          },
          "multiline_secondary": true
        },
        {
          "type": "custom:mushroom-entity-card",
          "entity": "switch.sunday_body_pet_mode",
          "name": "Petting reactions",
          "icon": "mdi:paw",
          "tap_action": {
            "action": "toggle"
          }
        },
        {
          "type": "entities",
          "title": "Petting confirmation",
          "show_header_toggle": false,
          "entities": [
            {
              "entity": "switch.sunday_body_petting_proximity_guard",
              "name": "Require nearby object"
            },
            {
              "entity": "binary_sensor.sunday_body_object_near_for_petting",
              "name": "Nearby object detected"
            },
            {
              "entity": "sensor.sunday_body_proximity_counts",
              "name": "Proximity reading (raw counts)"
            },
            {
              "entity": "number.sunday_body_petting_proximity_threshold",
              "name": "Near threshold (raw counts)"
            }
          ]
        },
        {
          "type": "custom:mushroom-chips-card",
          "alignment": "center",
          "chips": [
            {
              "type": "entity",
              "entity": "sensor.sunday_body_room_light",
              "icon": "mdi:brightness-5",
              "icon_color": "amber"
            },
            {
              "type": "entity",
              "entity": "sensor.sunday_body_wi_fi_signal",
              "icon": "mdi:wifi",
              "icon_color": "blue"
            },
            {
              "type": "entity",
              "entity": "sensor.sunday_body_uptime",
              "icon": "mdi:timer-outline",
              "icon_color": "grey"
            }
          ]
        },
        {
          "type": "heading",
          "heading": "Face",
          "heading_style": "title",
          "icon": "mdi:emoticon-outline"
        },
        {
          "type": "custom:mushroom-select-card",
          "entity": "select.sunday_body_expression",
          "name": "Expression",
          "icon": "mdi:emoticon-outline",
          "icon_color": "pink"
        },
        {
          "type": "custom:mushroom-select-card",
          "entity": "select.sunday_body_display",
          "name": "Display",
          "icon": "mdi:monitor-shimmer",
          "icon_color": "blue"
        },
        {
          "type": "custom:mushroom-select-card",
          "entity": "select.sunday_body_face_state",
          "name": "Face state (test)",
          "icon": "mdi:face-recognition",
          "icon_color": "purple"
        },
        {
          "type": "heading",
          "heading": "Head & sound",
          "heading_style": "title",
          "icon": "mdi:head-sync-outline"
        },
        {
          "type": "custom:mushroom-entity-card",
          "entity": "switch.sunday_body_head_motion",
          "name": "Head motion when petted",
          "icon": "mdi:head-sync-outline",
          "tap_action": {
            "action": "toggle"
          }
        },
        {
          "type": "custom:mushroom-entity-card",
          "entity": "switch.sunday_body_pet_mode_at_night",
          "name": "Pet mode at night",
          "icon": "mdi:paw-off",
          "tap_action": {
            "action": "toggle"
          }
        },
        {
          "type": "custom:mushroom-number-card",
          "entity": "number.sunday_body_volume",
          "name": "Volume",
          "icon": "mdi:volume-high",
          "display_mode": "slider",
          "icon_color": "teal"
        },
        {
          "type": "heading",
          "heading": "Night mode",
          "heading_style": "title",
          "icon": "mdi:weather-night"
        },
        {
          "type": "custom:mushroom-template-card",
          "entity": "switch.sunday_body_night_mode",
          "primary": "Night mode",
          "secondary": "{% if is_state('switch.sunday_body_night_mode','on') %}On \u00b7 {{ states('select.sunday_body_night_screen') }} \u00b7 LEDs {{ states('select.sunday_body_led_colour_night') }}{% else %}Off \u00b7 normal screen and LEDs{% endif %}",
          "icon": "{{ 'mdi:weather-night' if is_state('switch.sunday_body_night_mode','on') else 'mdi:weather-sunny' }}",
          "icon_color": "{{ 'deep-purple' if is_state('switch.sunday_body_night_mode','on') else 'amber' }}",
          "tap_action": {
            "action": "toggle"
          },
          "multiline_secondary": true
        },
        {
          "type": "custom:mushroom-select-card",
          "entity": "select.sunday_body_night_screen",
          "name": "Night screen",
          "icon": "mdi:monitor-off",
          "icon_color": "deep-purple"
        },
        {
          "type": "custom:mushroom-number-card",
          "entity": "number.sunday_body_night_brightness",
          "name": "Night brightness (dim face)",
          "icon": "mdi:brightness-4",
          "display_mode": "slider",
          "icon_color": "deep-purple"
        },
        {
          "type": "custom:mushroom-select-card",
          "entity": "select.sunday_body_led_colour_night",
          "name": "LED colour (night)",
          "icon": "mdi:led-off",
          "icon_color": "deep-purple"
        },
        {
          "type": "custom:mushroom-select-card",
          "entity": "select.sunday_body_led_colour_day",
          "name": "LED colour (day)",
          "icon": "mdi:led-on",
          "icon_color": "amber"
        },
        {
          "type": "heading",
          "heading": "Camera",
          "heading_style": "title",
          "icon": "mdi:camera"
        },
        {
          "type": "grid",
          "columns": 2,
          "square": false,
          "cards": [
            {
              "type": "custom:mushroom-template-card",
              "entity": "button.sunday_body_take_picture",
              "primary": "Take picture",
              "secondary": "Shows on her screen",
              "icon": "mdi:camera",
              "icon_color": "indigo",
              "tap_action": {
                "action": "toggle"
              },
              "layout": "vertical"
            },
            {
              "type": "custom:mushroom-entity-card",
              "entity": "switch.sunday_body_camera_preview",
              "name": "Camera preview",
              "icon": "mdi:video",
              "tap_action": {
                "action": "toggle"
              },
              "layout": "vertical"
            }
          ]
        }
      ]
    }
  ]
}